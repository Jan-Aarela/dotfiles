                    },
                    "name": "Sijah AK"
                },
                "description": "Moves every F/B.Silkscreen reference to its courtyard centroid with rotation, pad nudging and text scaling.",
                "description_full": "KiCad 9.0 action plugin that moves every footprint's silkscreen reference designator to the centroid of its courtyard bounding box.\n\nFeatures: settings dialog, scope control (all or selected), side filter (front/back/both), rotation control (match footprint, always 0°, or keep existing), auto text scale-down to fit courtyard, pad collision nudging, back-side support (B.Courtyard / B.Silkscreen), single undo transaction, optional CSV export of skipped footprints.",
                "identifier": "com.github.sijah.center-silk-ref",
                "license": "MIT",
                "name": "Center Silk Reference in Courtyard",
                "resources": {
                    "homepage": "https://github.com/sijah/kicad-silk-ref-center"
                },
                "type": "plugin",
